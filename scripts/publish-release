#!/usr/bin/env bash
# Publishes a file (an APK, a binary, an archive) as a release on the
# repository's Forgejo, and deletes
# releases beyond the newest $KEEP (default 10) together with their tags.
#
#   FORGEJO_API=https://forgejo.example.com/api/v1/repos/owner/repo \
#   FORGEJO_TOKEN=... NAME=MyApp scripts/publish-release 1.0.42 path/to/app.apk
#
# Meant for the CI job, which gets a token for its own repository.
set -euo pipefail
cd "$(dirname "$0")/.."

version="${1:?version, e.g. 1.0.42}"
file="${2:?path to the file to attach}"
name="${NAME:?project name, used in the release title and the file name}"
api="${FORGEJO_API:?}"
keep="${KEEP:-10}"
auth=(-H "Authorization: token ${FORGEJO_TOKEN:?}")
tag="v$version"

# What changed: this commit's message.
notes="$(git log -1 --format='%s%n%n%b')"
body="$(jq -n --arg name "$name" --arg tag "$tag" --arg commit "$(git rev-parse HEAD)" --arg notes "$notes" \
  '{tag_name: $tag, target_commitish: $commit, name: ($name + " " + $tag), body: $notes}')"

release="$(curl -fsS "${auth[@]}" -H 'Content-Type: application/json' \
  -X POST "$api/releases" -d "$body")"
id="$(jq -r '.id' <<< "$release")"
asset="$(tr '[:upper:] ' '[:lower:]-' <<< "$name")-$version.${file##*.}"
curl -fsS "${auth[@]}" -X POST "$api/releases/$id/assets?name=$asset" \
  -F "attachment=@$file" > /dev/null
echo "Released $tag: $(jq -r '.html_url' <<< "$release")"

# Newest first; everything past the first $keep goes.
curl -fsS "${auth[@]}" "$api/releases?limit=50" \
  | jq -r --argjson keep "$keep" \
      'sort_by(.created_at) | reverse | .[$keep:] | .[] | "\(.id) \(.tag_name)"' \
  | while read -r old_id old_tag; do
      curl -fsS "${auth[@]}" -X DELETE "$api/releases/$old_id" > /dev/null
      curl -fsS "${auth[@]}" -X DELETE "$api/tags/$old_tag" > /dev/null || true
      echo "removed $old_tag"
    done
