<?xml version="1.0" encoding="utf-8"?>
<!-- The lightest profile that still knows which app is in front: Android
     names the app in every typeWindowStateChanged event, so Pawse asks for no
     window content and no window list. A bank app refuses to run while a
     service that can read the screen is switched on. The cost is that only
     the app that just came to the front is known: split screen and
     picture-in-picture are no longer seen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:description="@string/watcher_description"
    android:notificationTimeout="0"
    android:settingsActivity="uk.pixxula.pawse.MainActivity" />
